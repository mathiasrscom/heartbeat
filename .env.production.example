# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DB=heartbeat
POSTGRES_USER=heartbeat
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── App ─────────────────────────────────────────────────────────────────
APP_PORT=3000
BETTER_AUTH_SECRET=generate-a-random-secret-here
BETTER_AUTH_URL=http://localhost:3000
IMAGE_NAME=ghcr.io/<owner>/<repo>
IMAGE_TAG=latest
# Directory containing the Pi user's authenticated Docker config.json.
DOCKER_CONFIG_PATH=/home/support/.docker

# ── AI providers (pick one or keep both available) ─────────────────────
# Ollama runs on the host and is accessed from Docker via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Intercom (optional – leave blank to skip sync) ──────────────────────
INTERCOM_ACCESS_TOKEN=
